<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1128"
    tools:context=".Hilo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Menú Superior Básico -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e293b"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="Inicio"
                android:textColor="#94a3b8"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="Hilos"
                android:textColor="#38bdf8"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="Solicitar"
                android:textColor="#94a3b8"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="Proveedores"
                android:textColor="#94a3b8"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Título Principal -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:text="HILOS Y MATERIALES"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Contenedor general para los productos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- 1. ALGODÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="#1e293b"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/algodon"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="#334155"
                    android:scaleType="centerCrop"
                    android:src="@drawable/algodon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Algodón"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAlgodon"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:text="COMPRAR"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:backgroundTint="#0284c7" />
            </LinearLayout>

            <!-- 2. POLIÉSTER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="#1e293b"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/Poliester"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="#334155"
                    android:scaleType="centerCrop"
                    android:src="@drawable/poliester" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Poliéster"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPoliester"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:text="COMPRAR"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:backgroundTint="#0284c7" />
            </LinearLayout>

            <!-- 3. NYLON -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="#1e293b"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/Nylon"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="#334155"
                    android:scaleType="centerCrop"
                    android:src="@drawable/nylon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nylon"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnNylon"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:text="COMPRAR"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:backgroundTint="#0284c7" />
            </LinearLayout>

            <!-- 4. SEDA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="#1e293b"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/Seda"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="#334155"
                    android:scaleType="centerCrop"
                    android:src="@drawable/seda" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Seda"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSeda"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:text="COMPRAR"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:backgroundTint="#0284c7" />
            </LinearLayout>

            <!-- 5. LANA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#1e293b"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/Lana"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="#334155"
                    android:scaleType="centerCrop"
                    android:src="@drawable/lana" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Lana"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnLana"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:text="COMPRAR"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:backgroundTint="#0284c7" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
