# Normalizar finales de linea entre Windows, macOS y Linux
* text=auto

# Codigo y configuracion con LF
*.java   text eol=lf
*.kt     text eol=lf
*.kts    text eol=lf
*.xml    text eol=lf
*.gradle text eol=lf
*.pro    text eol=lf
*.md     text eol=lf

# Binarios
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.jar  binary
*.ttf  binary
*.otf  binary
